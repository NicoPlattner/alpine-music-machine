# Nico's FastAPI backend. Vite exposes variables prefixed with VITE_ to browser code.
VITE_API_BASE_URL=http://localhost:8000

# Shelved experiment: keep false unless movement-controlled backend tempo is being tested.
VITE_ENABLE_MOVEMENT_SPEED_BACKEND=false

# Development-only nonsense lyric fixture for timeline testing.
VITE_ENABLE_DEV_KARAOKE_FIXTURE=false

# Lightweight Performance mode: disables camera, MediaPipe, motion analysis,
# genre gestures, segmentation, and point-cloud rendering. Karaoke/audio remain.
VITE_KARAOKE_ONLY_MODE=false
